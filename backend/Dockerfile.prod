FROM python:3.11

# uv: fast Python package manager (drop-in for pip via `uv pip`).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY requirements.txt requirements_prod.txt /

RUN uv pip install --system --no-cache -r /requirements.txt -r /requirements_prod.txt

WORKDIR /app
COPY . /app/
RUN uv pip install --system --no-cache -e .

CMD [\
    "gunicorn", "aoiportal.factory:create_app('/config.yaml')", \
    "--bind", "0.0.0.0:8000", \
    "--workers", "2", \
    "--access-logfile", "-"\
]
